+// Qt5 adaptation of QImageIOHandler::allocateImage allocation protection.
+// QT_IMAGEIO_MAXALLOC is MiB; 0 disables the policy limit, invalid/negative uses 256.
+static bool checkedTextObjectImage(const QSizeF &size, QImage *image)
+{
+    const qreal width = size.width(), height = size.height();
+    if (!qIsFinite(width) || !qIsFinite(height) || width <= 0 || height <= 0
+        || width > qreal(INT_MAX - 1) || height > qreal(INT_MAX - 1))
+        return false;
+    const QSize pixels = size.toSize();
+    if (pixels.isEmpty())
+        return false;
+    // Both dimensions are positive signed ints; their product times four fits quint64.
+    const quint64 bytes = quint64(pixels.width()) * quint64(pixels.height()) * 4;
+    bool ok = false;
+    int limit = qEnvironmentVariableIntValue("QT_IMAGEIO_MAXALLOC", &ok);
+    if (!ok || limit < 0)
+        limit = 256;
+    if (limit && bytes > quint64(limit) * 1024 * 1024)
+        return false;
+    *image = QImage(pixels, QImage::Format_ARGB32_Premultiplied);
+    return !image->isNull();
+}
